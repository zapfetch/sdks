{
  "name": "@zapfetchdev/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the ZapFetch v2 web scraping API.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose src/__tests__/unit/**/*.test.ts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --verbose src/__tests__/unit/**/*.test.ts",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --verbose src/__tests__/e2e/v2/*.test.ts --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapfetch/sdks.git"
  },
  "bugs": {
    "url": "https://github.com/zapfetch/sdks/issues"
  },
  "homepage": "https://github.com/zapfetch/sdks/tree/main/js-sdk#readme",
  "author": "ZapFetch <hello@zapfetch.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "1.15.0",
    "typescript-event-target": "^1.1.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "dotenv": "^16.4.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5",
    "uuid": "^9.0.1"
  },
  "keywords": [
    "zapfetch",
    "crawler",
    "web",
    "scraper",
    "api",
    "sdk",
    "llm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "minimatch@<10.2.3": ">=10.2.3",
      "rollup@<4.59.0": ">=4.59.0",
      "picomatch@<4.0.4": ">=4.0.4",
      "handlebars": ">=4.7.9",
      "brace-expansion": ">=5.0.5",
      "axios@<1.15.0": "1.15.0",
      "follow-redirects@<1.16.0": ">=1.16.0 <2.0.0"
    }
  }
}
